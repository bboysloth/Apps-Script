        sheet.getRange(startRow, 4, lastRow - 1, 1).setBackgrounds(extValues.map(([val]) => val === true ? ['#d9ead3'] : ['#f4cccc']));
        
        // --- ONE CHANGE: Force Checkboxes for SE Lead (Col 5) & In Person (Col 6) ---
        sheet.getRange(startRow, 5, lastRow - 1, 2).insertCheckboxes();
    }
    
    sheet.getRange("J1").setValue(`Last Refreshed: ${new Date().toLocaleString()}`);
    sheet.setColumnWidth(3, 230);
    sheet.setColumnWidth(10, 300);
    sheet.hideColumns(11, 5); // NEW: Hide K, L, M, N, O
    
    if (configs.showTaggedMeetings) {
        if (noTagMeetings.length > 0) {
            sheet.getRange(startRow, 1, noTagMeetings.length, 3).setBackground('#f4cccc');
        }
    } else if (configs.filterForMissingSETags) {
        if (noTagMeetings.length > 0) {
            sheet.getRange(startRow, 1, noTagMeetings.length, 3).setBackground('#f4cccc');
        }
        if (aeTaggedMeetings.length > 0) {
            sheet.getRange(startRow + noTagMeetings.length, 1, aeTaggedMeetings.length, 3).setBackground('#fff2cc');
        }
    } else {
        if (noTagMeetings.length > 0) {
            sheet.getRange(startRow, 1, noTagMeetings.length, 3).setBackground('#f4cccc');
        }
    }
    
    if (fullyTaggedMeetings.length > 0) {
        const offset = noTagMeetings.length + aeTaggedMeetings.length;
        // FIX: Apply Light Green 3 background to A:C instead of strikethrough
        sheet.getRange(startRow + offset, 1, fullyTaggedMeetings.length, 3).setBackground('#d9ead3');
    }
    // --- NEW (v2.7.12.1): Apply Suggestion Borders ---
    const SUGGESTION_COLOR = "#283e4d"; 
    const BORDER_STYLE = SpreadsheetApp.BorderStyle.SOLID_MEDIUM;

    if (lastRow > 1) {
        const checkRange = sheet.getRange(startRow, 5, lastRow - 1, 9).getValues(); 
        for (let i = 0; i < checkRange.length; i++) {
            const row = checkRange[i];
            const visibleRow = i + startRow;
            const suggestedSE = row[0]; 
            const suggestedIP = row[1]; 
            const suggestedTag = row[2]; 
            const originalSE = row[6];  
            const originalIP = row[7];  
            const originalTag = row[8]; 
            
            if (suggestedSE !== originalSE && suggestedSE) {
                sheet.getRange(visibleRow, 5).setBorder(true, true, true, true, false, false, SUGGESTION_COLOR, BORDER_STYLE);
            }
            if (suggestedIP !== originalIP && suggestedIP) {
                sheet.getRange(visibleRow, 6).setBorder(true, true, true, true, false, false, SUGGESTION_COLOR, BORDER_STYLE);
            }
            if (suggestedTag !== originalTag && suggestedTag) {
                sheet.getRange(visibleRow, 7).setBorder(true, true, true, true, false, false, SUGGESTION_COLOR, BORDER_STYLE);
            }
        }
    }
}

// --- REQUIRED DEPENDENCIES (Needed for Region 3 and 7 to work) ---

function _getVerkadaFiscalQuarter(date) {
  const month = date.getMonth(); 
  const year = date.getFullYear();
  const offsetDate = new Date(date);
  offsetDate.setMonth(date.getMonth() + 11);
  const fy = offsetDate.getFullYear();
  let q = 0;
  if (month >= 1 && month <= 3) q = 1;
  else if (month >= 4 && month <= 6) q = 2;
  else if (month >= 7 && month <= 9) q = 3;
  else q = 4;
  return { fiscalYear: fy, quarter: q, name: `FY${fy.toString().slice(-2)} Q${q}` };
}

function _getDatesForVerkadaFQ(fiscalYear, quarter) {
  const calYear = fiscalYear - 1;
  let startMonth = 0; 
  if (quarter === 1) startMonth = 1; 
  if (quarter === 2) startMonth = 4; 
  if (quarter === 3) startMonth = 7; 
  if (quarter === 4) startMonth = 10; 
  const start = new Date(calYear, startMonth, 1);
  const end = new Date(calYear, startMonth + 3, 0); 
  end.setHours(23, 59, 59, 999);
  if (quarter === 4) {
      const endQ4 = new Date(calYear + 1, 1, 0); 
      endQ4.setHours(23, 59, 59, 999);
      return { start, end: endQ4 };
  }
  return { start, end };
}

function updateTagDropdownsAndColors(silentMode = false) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const tagsSheet = ss.getSheetByName("Tags");
  const mainSheet = ss.getSheetByName("Untagged Meetings");
  if (!tagsSheet || !mainSheet) return;
  const lastTagRow = tagsSheet.getLastRow();
  if (lastTagRow < 2) return;
  const rawTags = tagsSheet.getRange(2, 2, lastTagRow - 1, 2).getValues(); 
  const dropdownList = ["<Clear Tag>"];
  const colors = ["#ffffff"]; 
  const rawColors = tagsSheet.getRange(2, 3, lastTagRow - 1, 1).getBackgrounds();
  for (let i = 0; i < rawTags.length; i++) {
      const tagName = rawTags[i][1]; 
      const color = rawColors[i][0];
      if (tagName && tagName !== "") {
          dropdownList.push(tagName);
          colors.push(color);
      }
  }
  const lastMainRow = mainSheet.getLastRow();
  if (lastMainRow > 1) {
      const rule = SpreadsheetApp.newDataValidation().requireValueInList(dropdownList, true).build();
      mainSheet.getRange(2, 7, lastMainRow - 1, 1).setDataValidation(rule);
      const rules = mainSheet.getConditionalFormatRules();
      const newRules = rules.filter(r => {
          const ranges = r.getRanges();
          return !ranges.some(rng => rng.getColumn() === 7);
      });
      const colorMap = {};
      for (let i = 1; i < dropdownList.length; i++) { 
          const t = dropdownList[i];
          const c = colors[i];
          if (!colorMap[c]) colorMap[c] = [];
          colorMap[c].push(t);
      }
      for (const [hex, tags] of Object.entries(colorMap)) {
          const escapedTags = tags.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
          const formula = `=REGEXMATCH(G2, "^(${escapedTags})$")`;
          const cfRule = SpreadsheetApp.newConditionalFormatRule()
              .whenFormulaSatisfied(formula)
              .setBackground(hex)
              .setRanges([mainSheet.getRange("G2:G")])
              .build();
          newRules.push(cfRule);
      }
      mainSheet.setConditionalFormatRules(newRules);
  }
  if (!silentMode) ss.toast("Dropdowns and colors updated.");
}
